import pandas as pd
import matplotlib.pyplot as plt


def indlæs_data_og_overblik(filnavn):
    df = pd.read_csv(filnavn)

    print(f"Datasættet har {df.shape[0]} rækker og {df.shape[1]} kolonner.")
    print("\nHer ses datatyper og antal ikke-manglende værdier:")
    df.info()
    print("\nHer ses et samlet overblik over de numeriske kolonner:")
    print(df.describe())

    return df


def analyse_af_numerisk_data(df, col1, col2):
    return df.groupby(col1)[col2].agg(
        ["mean", "std", "median", "count"]
    )


def lav_soejle_graf_mean_og_gem_PNG(df, col1, col2):
    plotted_data = df.groupby(col1)[col2].mean()

    plotted_data.plot(kind="bar", rot=0)
    plt.title(f"Gennemsnitlig {col2} fordelt på {col1}")
    plt.xlabel(col1)
    plt.ylabel(f"Gennemsnitlig {col2}")
    plt.ylim(bottom=0)

    plt.tight_layout()
    plt.savefig("outputs/02_data_plot.png", dpi=300)
    plt.show()
    plt.close()


def main():
    # 1. Indlæs data og vis overblik
    titanic = indlæs_data_og_overblik("titanic.csv")

    # 2. Analysér numeriske data
    resultat = analyse_af_numerisk_data(
        titanic, "Pclass", "Survived"
    )
    print("\nResultat af den numeriske analyse:")
    print(resultat)

    # 3. Lav og gem søjlediagram
    lav_soejle_graf_mean_og_gem_PNG(
        titanic, "Pclass", "Survived"
    )


if __name__ == "__main__":
    main()


