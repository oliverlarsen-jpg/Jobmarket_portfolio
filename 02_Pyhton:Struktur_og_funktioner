# %%
#Sortér efter den største daglige kursændring
aktier = stock_prices.columns.drop("Date")
daglige_aendringer = stock_prices[aktier].pct_change() * 100

daglige_aendringer.columns = [
    f"{aktie}_pct_change" for aktie in aktier
]

stock_prices_and_returns = pd.concat(
    [stock_prices, daglige_aendringer],
    axis=1
)

print(stock_prices_and_returns.head())
# %%
#Groupby() efter år, og find gennemsnitligt afkast per år
stock_prices_and_returns["Date"] = pd.to_datetime(
    stock_prices_and_returns["Date"]
)

stock_prices_and_returns["År"] = (
    stock_prices_and_returns["Date"].dt.year
)

afkast_kolonner = stock_prices_and_returns.columns[
    stock_prices_and_returns.columns.str.endswith("_pct_change")
]

årligt_gennemsnitsafkast = (
    stock_prices_and_returns
    .groupby("År")[afkast_kolonner]
    .mean()
)

print(årligt_gennemsnitsafkast)

