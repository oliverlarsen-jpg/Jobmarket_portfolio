#Sortering på aktiekurs, faldende, for to aktier
stock_prices_sorted = stock_prices.sort_values(
    by=["MSFT", "AAPL"],
    ascending=[False, False]
)
 #Sorteres først på AAPL, hvis to eller flere værdier for MSFT er ens.
