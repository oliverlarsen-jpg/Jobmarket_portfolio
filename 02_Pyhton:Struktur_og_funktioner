# %%
#Pivotér daglige aktieafkast ud fra daglige_aendringer (fra bred til lang til bred):
afkast_long = daglige_aendringer.copy()

afkast_long["Date"] = stock_prices["Date"].values

afkast_long = afkast_long.melt(
    id_vars="Date",
    var_name="Aktie",
    value_name="Afkast_pct"
)

afkast_wide = afkast_long.pivot(
    index="Date",
    columns="Aktie",
    values="Afkast_pct"
)

print(afkast_wide.head()) #Rækkefølgen af aktier ændres!

# %%
#Gør datoen til indeks
stock_prices["Date"] = pd.to_datetime(stock_prices["Date"])

stock_prices = stock_prices.set_index("Date")
#%%
print(stock_prices.head())

# %%
# NumPy-vektorisering, hvor hensigtsmæssigt (arrays)
    #Med for-loop bestemmes daglige kursændringer således:
msft = stock_prices["MSFT"]

kursaendringer = []

for i in range(1, len(msft)):
    aendring = msft.iloc[i] - msft.iloc[i - 1]
    kursaendringer.append(aendring)
#%%
    #Daglige kursændringer kan lettere bestemmes således med NumPy:
kursaendringer = stock_prices.drop(columns=["År"]).diff()

kursaendringer.head()
# %%
# Daglige afkast kan let bestemmes som:
daglige_afkast = stock_prices.pct_change() * 100

daglige_afkast.describe()
# %%
#Gennemsnitlige daglige afkast kan bestemmes ud fra årlige afkast
# Første og sidste observerede kurs i hvert kalenderår
første_kurs = stock_prices.groupby(
    stock_prices.index.year
).first()

sidste_kurs = stock_prices.groupby(
    stock_prices.index.year
).last()

# Samlet kalenderårsafkast
årligt_afkast = sidste_kurs / første_kurs - 1

# Antal daglige perioder mellem årets første og sidste kurs
antal_dage = stock_prices.groupby(
    stock_prices.index.year
).count() - 1

# Geometrisk gennemsnitligt dagligt afkast
gennemsnitligt_dagligt_afkast = (
    (1 + årligt_afkast) ** (1 / antal_dage) - 1
)

print((gennemsnitligt_dagligt_afkast.drop(columns=["År"]) * 100).round(4))

